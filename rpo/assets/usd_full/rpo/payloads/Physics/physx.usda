#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "rpourdf"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "rpourdf"
{
    over "Physics"
    {
        over "left_thigh_yaw_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "left_thigh_roll_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
