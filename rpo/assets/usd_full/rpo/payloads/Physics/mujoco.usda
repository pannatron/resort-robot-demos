        def MjcActuator "left_thigh_yaw_joint_actuator"
        {
            uniform double mjc:forceRange:max = 120
            uniform double mjc:forceRange:min = -120
            custom rel mjc:target
            append rel mjc:target = </rpourdf/Physics/left_thigh_yaw_joint>
        }

        def MjcActuator "left_thigh_roll_joint_actuator"
        {
            uniform double mjc:forceRange:max = 120
