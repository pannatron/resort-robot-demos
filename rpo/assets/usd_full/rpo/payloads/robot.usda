#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "rpourdf"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "rpourdf" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "left_thigh_yaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_thigh_yaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "torso_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_thigh_roll_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_thigh_pitch_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_knee_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_ankle_pitch_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_ankle_roll_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_thigh_roll_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_thigh_pitch_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_knee_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_ankle_pitch_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_ankle_roll_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_arm_pitch_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_arm_pitch_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_arm_roll_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_arm_yaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_elbow_pitch_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "left_elbow_yaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_arm_roll_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_arm_yaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_elbow_pitch_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "right_elbow_yaw_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "left_thigh_yaw_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_thigh_roll_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "left_thigh_pitch_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "left_knee_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "left_ankle_pitch_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "left_ankle_roll_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }

            over "right_thigh_yaw_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_thigh_roll_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_thigh_pitch_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_knee_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "right_ankle_pitch_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "right_ankle_roll_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }

            over "torso_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "left_arm_pitch_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "left_arm_roll_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "left_arm_yaw_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "left_elbow_pitch_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "left_elbow_yaw_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }

                over "right_arm_pitch_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "right_arm_roll_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "right_arm_yaw_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "right_elbow_pitch_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "right_elbow_yaw_link" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

