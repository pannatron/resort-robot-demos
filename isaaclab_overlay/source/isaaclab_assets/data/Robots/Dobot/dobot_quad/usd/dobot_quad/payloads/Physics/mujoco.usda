#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "dobot_quad"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "dobot_quad"
{
    over "Physics"
    {
        over "joint_front_left_abad" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_front_left_thigh_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_front_left_calf_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_front_right_abad" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_front_right_thigh_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_front_right_calf_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_rear_left_abad" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_rear_left_thigh_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_rear_left_calf_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_rear_right_abad" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_rear_right_thigh_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        over "joint_rear_right_calf_pitch" (
            delete apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            prepend apiSchemas = ["MjcJointAPI"]
        )
        {
        }

        def MjcActuator "joint_front_left_abad_actuator"
        {
            uniform double mjc:forceRange:max = 23
            uniform double mjc:forceRange:min = -23
            custom rel mjc:target
            append rel mjc:target = </dobot_quad/Physics/joint_front_left_abad>
        }

        def MjcActuator "joint_front_left_thigh_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 23
            uniform double mjc:forceRange:min = -23
            custom rel mjc:target
            append rel mjc:target = </dobot_quad/Physics/joint_front_left_thigh_pitch>
        }

        def MjcActuator "joint_front_left_calf_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 55
            uniform double mjc:forceRange:min = -55
            custom rel mjc:target
            append rel mjc:target = </dobot_quad/Physics/joint_front_left_calf_pitch>
        }

        def MjcActuator "joint_front_right_abad_actuator"
        {
            uniform double mjc:forceRange:max = 23
            uniform double mjc:forceRange:min = -23
            custom rel mjc:target
            append rel mjc:target = </dobot_quad/Physics/joint_front_right_abad>
        }

        def MjcActuator "joint_front_right_thigh_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 23
            uniform double mjc:forceRange:min = -23
            custom rel mjc:target
            append rel mjc:target = </dobot_quad/Physics/joint_front_right_thigh_pitch>
        }

        def MjcActuator "joint_front_right_calf_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 55
            uniform double mjc:forceRange:min = -55
            custom rel mjc:target
            append rel mjc:target = </dobot_quad/Physics/joint_front_right_calf_pitch>
        }

        def MjcActuator "joint_rear_left_abad_actuator"
        {
            uniform double mjc:forceRange:max = 23
            uniform double mjc:forceRange:min = -23
            custom rel mjc:target
            append rel mjc:target = </dobot_quad/Physics/joint_rear_left_abad>
        }

        def MjcActuator "joint_rear_left_thigh_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 23
            uniform double mjc:forceRange:min = -23
            custom rel mjc:target
            append rel mjc:target = </dobot_quad/Physics/joint_rear_left_thigh_pitch>
        }

        def MjcActuator "joint_rear_left_calf_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 55
            uniform double mjc:forceRange:min = -55
            custom rel mjc:target
            append rel mjc:target = </dobot_quad/Physics/joint_rear_left_calf_pitch>
        }

        def MjcActuator "joint_rear_right_abad_actuator"
        {
            uniform double mjc:forceRange:max = 23
            uniform double mjc:forceRange:min = -23
            custom rel mjc:target
            append rel mjc:target = </dobot_quad/Physics/joint_rear_right_abad>
        }

        def MjcActuator "joint_rear_right_thigh_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 23
            uniform double mjc:forceRange:min = -23
            custom rel mjc:target
            append rel mjc:target = </dobot_quad/Physics/joint_rear_right_thigh_pitch>
        }

        def MjcActuator "joint_rear_right_calf_pitch_actuator"
        {
            uniform double mjc:forceRange:max = 55
            uniform double mjc:forceRange:min = -55
            custom rel mjc:target
            append rel mjc:target = </dobot_quad/Physics/joint_rear_right_calf_pitch>
        }
    }
}

