#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "dobot_quad_wheel"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "dobot_quad_wheel" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    custom rel isaac:physics:robotJoints
    custom rel isaac:physics:robotLinks

    over "Physics"
    {
        over "joint_front_left_abad" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_front_right_abad" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_rear_left_abad" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_rear_right_abad" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_front_left_thigh_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_front_left_calf_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_front_left_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_front_right_thigh_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_front_right_calf_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_front_right_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_rear_left_thigh_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_rear_left_calf_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_rear_left_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_rear_right_thigh_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_rear_right_calf_pitch" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "joint_rear_right_wheel" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }

    over "Geometry"
    {
        over "link_trunk" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "link_front_left_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link_front_left_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link_front_left_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link_front_left_wheel" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "link_front_right_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link_front_right_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link_front_right_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link_front_right_wheel" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "link_rear_left_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link_rear_left_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link_rear_left_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link_rear_left_wheel" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }

            over "link_rear_right_hip" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "link_rear_right_thigh" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "link_rear_right_calf" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "link_rear_right_wheel" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                        }
                    }
                }
            }
        }
    }
}

